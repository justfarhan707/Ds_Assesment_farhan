# Browser-visible configuration. Copy to .env.local for local development.
# Set these same variables in Vercel before deploying.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Configure these in Supabase Edge Functions
# GEMINI_API_KEY = your provider API key
# REPLY_MODEL = your tested Gemini generation model ID
# Supabase provides its hosted runtime URL and database keys automatically.
# Never put service-role keys or provider secrets in VITE_ variables.
